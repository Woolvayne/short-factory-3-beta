{
  "openapi": "3.1.0",
  "info": {
    "title": "ShortsFactory Cloud Worker",
    "version": "1.0.0",
    "description": "Server-side shorts factory and JSON API gateway for AI agents. POST a job (background video URL or upload plus up to 10 ideas or complete scripts) and MP4 shorts are rendered in the cloud — the client may disconnect immediately. An agent can send scripts as strings or {title, script} objects; supplied scripts are voiced verbatim after the intro title and skip story generation. Poll until done/partial, then download each MP4. Auth: 'Authorization: Bearer sfk_…' on every /v1 call (GET downloads also accept '?api_key=sfk_…'). Admin endpoints use ADMIN_TOKEN. Voice is Microsoft Edge neural TTS (free). Missing scripts are generated by Qwen/Mistral when configured, otherwise the offline writer. Background source must be a DIRECT video file URL or a prior upload — platform page links (YouTube, TikTok …) are rejected. The standalone POST /v1/tts endpoint also returns MP3 audioBase64 and word timings, so an agent can use Railway as a direct replacement for the former Supabase TTS call."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "sfk_… key minted via POST /v1/keys"
      }
    },
    "schemas": {
      "Settings": {
        "type": "object",
        "description": "All optional — sensible defaults match the browser app.",
        "properties": {
          "voice": {
            "type": "string",
            "default": "en-US-AndrewNeural",
            "description": "Edge neural voice id, e.g. en-US-JennyNeural, en-GB-RyanNeural"
          },
          "rate": {
            "type": "number",
            "default": 2,
            "description": "speaking rate % (-40…40)"
          },
          "pitch": {
            "type": "number",
            "default": 0,
            "description": "pitch Hz (-20…20)"
          },
          "storyStyle": {
            "type": "string",
            "enum": [
              "aita",
              "revenge",
              "confession",
              "creepy",
              "wholesome",
              "workplace",
              "custom"
            ],
            "default": "aita"
          },
          "customPrompt": {
            "type": "string",
            "description": "used when storyStyle=custom"
          },
          "storyWords": {
            "type": "number",
            "default": 185
          },
          "temperature": {
            "type": "number",
            "default": 1.05
          },
          "qwenKey": {
            "type": "string",
            "description": "optional per-job DashScope key (else QWEN_API_KEY env, else offline writer)"
          },
          "mistralKey": {
            "type": "string"
          },
          "captionsOn": {
            "type": "boolean",
            "default": true
          },
          "wordsPerCue": {
            "type": "number",
            "default": 3
          },
          "captionScale": {
            "type": "number",
            "default": 0.074
          },
          "captionY": {
            "type": "number",
            "default": 0.6
          },
          "captionColor": {
            "type": "string",
            "default": "#ffffff"
          },
          "outlineWidth": {
            "type": "number",
            "default": 0.16
          },
          "uppercase": {
            "type": "boolean",
            "default": true
          },
          "captionShadow": {
            "type": "boolean",
            "default": true
          },
          "quality": {
            "type": "string",
            "enum": [
              "auto",
              "540",
              "720",
              "1080"
            ],
            "default": "auto",
            "description": "auto = 720p on the cloud worker"
          },
          "fps": {
            "type": "number",
            "enum": [
              24,
              30,
              60
            ],
            "default": 30
          },
          "bitrate": {
            "type": "string",
            "enum": [
              "low",
              "med",
              "high"
            ],
            "default": "med"
          },
          "vignette": {
            "type": "boolean",
            "default": true
          },
          "tailPadding": {
            "type": "number",
            "default": 0.6
          },
          "voiceVolume": {
            "type": "number",
            "default": 1
          },
          "musicVolume": {
            "type": "number",
            "default": 0.13
          },
          "musicFade": {
            "type": "boolean",
            "default": true
          },
          "clipMode": {
            "type": "string",
            "enum": [
              "even",
              "random",
              "sequential"
            ],
            "default": "even"
          },
          "clipSkipIntro": {
            "type": "number",
            "default": 5
          },
          "clipSkipOutro": {
            "type": "number",
            "default": 5
          },
          "clipLengthMode": {
            "type": "string",
            "enum": [
              "auto",
              "fixed"
            ],
            "default": "auto"
          },
          "clipFixedLength": {
            "type": "number",
            "default": 35
          },
          "introOn": {
            "type": "boolean",
            "default": true,
            "description": "simplified Reddit card burned into the first seconds"
          },
          "introTitleMode": {
            "type": "string",
            "enum": [
              "idea",
              "custom"
            ],
            "default": "idea"
          },
          "introTitle": {
            "type": "string"
          },
          "introSubreddit": {
            "type": "string",
            "default": "r/AmItheAsshole"
          },
          "introAuthor": {
            "type": "string",
            "default": "u/Throwaway_42"
          },
          "introAgeLabel": {
            "type": "string",
            "default": "12h"
          },
          "introUpvotes": {
            "type": "number",
            "default": 15400
          },
          "introDuration": {
            "type": "number",
            "default": 3
          },
          "introTheme": {
            "type": "string",
            "enum": [
              "dark",
              "light"
            ],
            "default": "dark"
          },
          "introPosY": {
            "type": "number",
            "default": 0.36
          },
          "introShowStats": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "done",
              "partial",
              "failed",
              "canceled"
            ]
          },
          "progress": {
            "type": "object",
            "properties": {
              "done": {
                "type": "number"
              },
              "total": {
                "type": "number"
              }
            }
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "number"
                },
                "title": {
                  "type": "string",
                  "description": "The title shown on the intro card and spoken first when introOn is true"
                },
                "idea": {
                  "type": "string"
                },
                "script": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The complete script used for TTS; null while the unit is still queued"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "queued",
                    "script",
                    "voice",
                    "staged",
                    "rendering",
                    "done",
                    "error"
                  ]
                },
                "videoPath": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "GET this path (with auth) to download the MP4 once done"
                },
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "TtsRequest": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 30000
          },
          "voice": {
            "type": "string",
            "default": "en-US-AndrewNeural",
            "description": "Microsoft Edge neural voice id"
          },
          "rate": {
            "type": "number",
            "minimum": -50,
            "maximum": 50,
            "default": 0
          },
          "pitch": {
            "type": "number",
            "minimum": -50,
            "maximum": 50,
            "default": 0
          }
        }
      },
      "TtsResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "format": {
            "type": "string",
            "example": "audio/mpeg"
          },
          "voice": {
            "type": "string"
          },
          "duration": {
            "type": "number"
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "offset": {
                  "type": "number"
                },
                "duration": {
                  "type": "number"
                }
              }
            }
          },
          "audioBase64": {
            "type": "string",
            "description": "Base64-encoded MP3; decode and save as .mp3"
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "security": [],
        "summary": "Liveness + queue depth",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/v1/keys": {
      "post": {
        "summary": "Mint an API key for an AI agent (ADMIN_TOKEN required)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "returns { key: 'sfk_…' } exactly once"
          }
        }
      },
      "get": {
        "summary": "List keys (admin)",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/v1/keys/{id}": {
      "delete": {
        "summary": "Revoke a key (admin)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/v1/uploads": {
      "post": {
        "summary": "Upload a background video or music file (raw request body, max MAX_UPLOAD_MB)",
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "{ uploadId }"
          }
        }
      }
    },
    "/v1/tts": {
      "post": {
        "summary": "Synthesize speech only (Railway TTS replacement for Supabase TTS)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TtsRequest"
              },
              "example": {
                "text": "Hello from Railway",
                "voice": "en-US-AndrewNeural",
                "rate": 0,
                "pitch": 0
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MP3 audio plus word timings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TtsResponse"
                }
              }
            }
          },
          "400": {
            "description": "text missing"
          },
          "502": {
            "description": "upstream TTS failure"
          }
        }
      }
    },
    "/v1/jobs": {
      "post": {
        "summary": "Queue a render job (fire and forget — client may disconnect)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "videoUrl": {
                    "type": "string",
                    "description": "direct, publicly reachable video file URL (mp4/webm). Required unless uploadId is set."
                  },
                  "uploadId": {
                    "type": "string",
                    "description": "id from POST /v1/uploads"
                  },
                  "musicUrl": {
                    "type": "string"
                  },
                  "musicUploadId": {
                    "type": "string"
                  },
                  "count": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 10,
                    "default": 10
                  },
                  "ideas": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "story premises/titles, one per short; missing entries are auto-generated"
                  },
                  "titles": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "optional explicit intro titles, matched by array index"
                  },
                  "scripts": {
                    "type": "array",
                    "description": "Complete scripts written by the agent. Each item is a string or an object with title and script/text; supplied scripts skip AI story generation.",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string",
                          "maxLength": 50000
                        },
                        {
                          "oneOf": [
                            {
                              "type": "object",
                              "properties": {
                                "title": {
                                  "type": "string",
                                  "maxLength": 500
                                },
                                "script": {
                                  "type": "string",
                                  "maxLength": 50000
                                }
                              },
                              "required": [
                                "script"
                              ]
                            },
                            {
                              "type": "object",
                              "properties": {
                                "title": {
                                  "type": "string",
                                  "maxLength": 500
                                },
                                "text": {
                                  "type": "string",
                                  "maxLength": 50000
                                }
                              },
                              "required": [
                                "text"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  },
                  "script": {
                    "description": "Convenience alias for one complete script",
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object"
                      }
                    ]
                  },
                  "stories": {
                    "type": "array",
                    "deprecated": true,
                    "items": {
                      "type": "string"
                    },
                    "description": "Legacy alias for scripts"
                  },
                  "settings": {
                    "$ref": "#/components/schemas/Settings"
                  }
                }
              },
              "example": {
                "videoUrl": "https://example.com/parkour.mp4",
                "count": 2,
                "scripts": [
                  {
                    "title": "My roommate stole my meal prep for three months",
                    "script": "I labelled every container in the fridge, but my roommate kept taking them. I finally left one with a harmless surprise note, and the next morning the entire building knew what had been happening."
                  },
                  "My boss scheduled a meeting during my wedding, so I sent the calendar invite to everyone."
                ],
                "settings": {
                  "voice": "en-US-AndrewNeural",
                  "storyStyle": "revenge",
                  "quality": "720",
                  "introOn": true
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "job accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List jobs",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/v1/jobs/{id}": {
      "get": {
        "summary": "Poll job status until done/partial/failed",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Cancel a job and delete its files",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/v1/jobs/{id}/videos/{n}": {
      "get": {
        "summary": "Download the finished MP4 of unit n (1-based). Also accepts ?api_key=sfk_…",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "n",
            "in": "path",
            "required": true,
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "video/mp4"
          },
          "404": {
            "description": "not ready"
          }
        }
      }
    }
  }
}
