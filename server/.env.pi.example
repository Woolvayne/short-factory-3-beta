# ── ShortsFactory Cloud Worker auf dem Raspberry Pi ──────────────────────────
#
# Kopieren nach `server/.env` und anpassen:
#   cp server/.env.pi.example server/.env
#
# Der Worker liest KEINE .env-Datei selbst ein — die Werte kommen über die
# Umgebung. Zwei Wege:
#   1) systemd (empfohlen): `EnvironmentFile=` in shortsfactory.service lädt sie.
#   2) manuell:  `set -a; source server/.env; set +a; npm start`
#
# Vollständige Anleitung: docs/RASPBERRY_PI.md

# Pflicht: langes Zufallsgeheimnis für die Key-Verwaltung (POST /v1/keys).
# Erzeugen: openssl rand -hex 32
ADMIN_TOKEN=hier-langes-zufallsgeheimnis-eintragen

# Wo Jobs, Uploads und API-Key-Hashes liegen (ausserhalb des Repos, damit
# `git pull` nichts löscht und Backups einfach bleiben).
DATA_DIR=/home/pi/shortsfactory-data
PORT=8080

# ── Pi-Tuning (Raspberry Pi 3B+ mit 1 GB RAM) ───────────────────────────────
PI_MODE=1                # markiert das Profil in GET /health
FFMPEG_PRESET=ultrafast  # statt veryfast: deutlich schneller, etwas grössere Dateien
DEFAULT_QUALITY=540      # "auto" bedeutet auf dem Pi 540p (halbiert die Renderzeit)
MAX_JOBS=3               # weniger fertige Jobs auf der SD-Karte behalten
MAX_UPLOAD_MB=500        # Upload-Limit für Hintergrundvideos

# ── Optionale AI-Story-Keys ─────────────────────────────────────────────────
# Ohne Keys nutzt der Worker den eingebauten Offline-Storywriter.
# QWEN_API_KEY=sk-...
# MISTRAL_API_KEY=...

# Nur zum Testen ohne Microsoft-Endpunkt: stumme Tonspur + gleichmässige Timings.
# TTS_FAKE=1
